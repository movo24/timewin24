DATABASE_URL="postgresql://timewin:timewin_secret@localhost:5433/timewin?schema=public"
NEXTAUTH_SECRET="change-me-to-a-random-string-minimum-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ─── Optionnelles (voir docs/RUNBOOK-EXPLOITATION.md §1) ───
# Secret des JWT scanner inventaire (fallback: NEXTAUTH_SECRET si absent)
INVENTORY_JWT_SECRET=""
# URL publique côté client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Garde-fou DSN — DOIT rester false (dépôt réel = Tier-3)
DSN_SUBMISSION_ENABLED="false"

# Moteur IA (désactivé si GEMINI_API_KEY absent)
GEMINI_API_KEY=""
AI_ENGINE_ENABLED="false"
AI_ANOMALY_ENABLED="false"
AI_ASSISTANT_ENABLED="false"
AI_NLP_ENABLED="false"
AI_PERFORMANCE_ENABLED="false"

# Email (SMTP) — envoi inactif si absent
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Push web (VAPID) — push inactif si absent
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# SMS (Twilio) — SMS inactif si absent
TWILIO_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Logs
LOG_LEVEL="info"
