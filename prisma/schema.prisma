  sales        Float    @default(0)
  transactions Int      @default(0)

  createdAt DateTime @default(now())

  @@unique([employeeId, storeId, date, hour])
  @@index([storeId, date])
  @@index([employeeId, date])
}

model EmployeePerformanceScore {
  id                String           @id @default(cuid())
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId        String
  storeId           String
  periodStart       DateTime
  periodEnd         DateTime
  overallScore      Float            @default(0)
  salesScore        Float            @default(0)
  productivityScore Float            @default(0)
  upsellScore       Float            @default(0)
  disciplineScore   Float            @default(0)
  inventoryScore    Float            @default(0)
  rank              Int?
  badge             PerformanceBadge @default(MOYEN)
  breakdown         Json?

  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, storeId, periodStart])
  @@index([employeeId])
  @@index([storeId])
  @@index([overallScore(sort: Desc)])
}
