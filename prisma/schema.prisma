// ─── Planning notification audit (RH/legal trace) ──────
// One row per (employee × send) — proves what was sent, when, and to whom.
// shiftSnapshotHash lets the UI detect "modified after sent" vs "still in sync".

enum PlanningNotificationStatus {
  SENT // email accepted by SMTP provider
  FAILED // SMTP error (auth, rate limit, etc.)
  NO_EMAIL // employee has no email address
  PARTIAL // (reserved) part of a batch where some failed
}

model PlanningNotification {
  id String @id @default(cuid())

  // Recipient
  // SetNull (not Cascade) → preserves the audit trail even if the employee is deleted.
  // Critical for RH/legal disputes ("je n'ai jamais reçu mon planning").
  // employeeSnapshot keeps the name even if the FK becomes null.
  employee         Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId       String?
  employeeSnapshot String? // "Firstname Lastname" at send time
  emailUsed        String? // address actually used (snapshot)

  // Scope
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeId     String? // null = multi-store (admin-wide send)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  // Audit — sender info preserved even if the user account is deleted.
  sentByUser         User?    @relation("PlanningNotificationSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  sentByUserId       String?
  sentByUserSnapshot String? // user name at send time
  sentAt             DateTime @default(now())

  // Status & details
  status            PlanningNotificationStatus
  shiftCount        Int                        @default(0)
  totalHours        Float                      @default(0)
  error             String? // sanitized error if status = FAILED
  providerMessageId String? // future: Resend/SES message id

  // Snapshot fingerprint of the shifts at send time
  // Format: SHA-256 hex of "date|start|end|storeId" lines (deterministic order)
  // Lets the UI detect if planning has been modified since this send.
  shiftSnapshotHash String?

  createdAt DateTime @default(now())

  @@index([employeeId, sentAt])
  @@index([storeId, periodStart])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@index([sentByUserId, sentAt])
}

// ─── AI Engine ──────────────────────────────────────────

// Stockage d'embeddings vectoriels (pgvector)
// Note: la colonne "embedding vector(768)" est ajoutée via raw SQL migration
model AiEmbedding {
  id         String   @id @default(cuid())
  entityType String // "employee", "store", "shift", "journal", "conversation"
  entityId   String
  content    String // Texte source de l'embedding
  metadata   Json? // Données structurées associées
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
}

// Scores IA calculés par employé
model EmployeeAiMetrics {
  id               String    @id @default(cuid())
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId       String    @unique
  performanceScore Float     @default(0) // 0-100
  upsellScore      Float     @default(0) // 0-100
  riskScore        Float     @default(0) // 0-100
  regularityScore  Float     @default(0) // 0-100
  fraudRiskScore   Float     @default(0) // 0-100
  breakdown        Json? // Détail des calculs (PerformanceBreakdown)
  periodStart      DateTime?
  periodEnd        DateTime?
  calculatedAt     DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([employeeId])
  @@index([calculatedAt])
}

// Anomalies détectées par le moteur IA
enum AiAnomalyType {
  CLOCK_DISCREPANCY
  REVENUE_DROP
  GHOST_SHIFT
  PATTERN_BREAK
  OVERTIME_ABUSE
  LOCATION_MISMATCH
}

enum AiAnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiAnomalyStatus {
  DETECTED
  CONFIRMED
  REJECTED
  RESOLVED
}

model AiAnomaly {
  id              String            @id @default(cuid())
  type            AiAnomalyType
  severity        AiAnomalySeverity @default(MEDIUM)
  status          AiAnomalyStatus   @default(DETECTED)
  employeeId      String?
  storeId         String
  date            DateTime          @db.Date
  description     String
  evidence        Json // AnomalyEvidence
  suggestedAction String?
  reviewedBy      String? // User.id
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([storeId, date])
  @@index([employeeId])
  @@index([type, status])
  @@index([status])
  @@index([createdAt])
}

// Conversations avec l'assistant IA
model AiConversation {
  id        String      @id @default(cuid())
  userId    String // User.id
  storeId   String? // Contexte magasin (optionnel)
  title     String? // Titre auto-généré
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// Messages dans une conversation IA
model AiMessage {
  id             String         @id @default(cuid())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String // "user" | "assistant"
  content        String
  sources        Json? // AssistantSource[]
  tokensUsed     Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ─── Centre de Contrôle Applications ──────────────────

enum ConnectedAppStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}

model ConnectedApp {
  id       String             @id @default(cuid())
  name     String // "POS Caisse Paris", "Comptabilité Sage"
  type     String // "pos", "accounting", "hr", "erp", "custom"
  provider String? // "caisse-addx", "sage", "lightspeed"
  status   ConnectedAppStatus @default(DISCONNECTED)
  internal Boolean            @default(false) // true = app interne AddX

  // Connexion
  apiUrl        String?
  apiKey        String?
  webhookUrl    String?
  webhookSecret String? @unique

  // Scope
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeId String? // null = app globale (toutes les unités)

  // Sync
  lastSyncAt   DateTime?
  lastErrorMsg String?
  syncInterval Int       @default(60) // minutes, 0 = manuel
  config       String? // JSON libre

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([storeId])
}

// ─── Events POS reçus en temps réel ───────────────────

model PosEvent {
  id          String    @id @default(cuid())
  eventType   String // "sale.completed", "sale.voided", "session.opened", "session.closed", "stock.alert"
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId  String? // FK vers Employee.id (si applicable)
  payload     Json // Données brutes de l'event
  processedAt DateTime? // null = pas encore traité
  error       String? // Message d'erreur si traitement échoué
  createdAt   DateTime  @default(now())

  @@index([storeId, createdAt])
  @@index([eventType])
  @@index([processedAt])
  @@index([createdAt])
}

// ─── Service API Keys (service-to-service auth) ──────

model ServiceApiKey {
  id         String    @id @default(cuid())
  name       String // "POS CAISSE Backoffice", "Accounting Sync"
  key        String    @unique // Le token Bearer envoyé par le service
  service    String // "pos-caisse", "accounting", "erp"
  role       Role      @default(ADMIN) // Rôle simulé pour les permissions RBAC
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdBy  String // userId qui a créé la clé
