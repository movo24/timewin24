# ══════════════════════════════════════════════════════
# TimeWin24 — Production Environment
# ══════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────
POSTGRES_USER=timewin
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_securise_32_chars
POSTGRES_DB=timewin
# DATABASE_URL built by docker-compose or set explicitly:
# DATABASE_URL=postgresql://user:password@host:5432/timewin

# ── NextAuth ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://timewin.yourdomain.com
# Optionnel : secret dédié aux tokens JWT inventaire (mobile).
# Si absent, retombe sur NEXTAUTH_SECRET. Recommandé : un secret distinct.
# Generate with: openssl rand -hex 32
# INVENTORY_JWT_SECRET=
# If behind reverse proxy, set internal URL:
# NEXTAUTH_URL_INTERNAL=http://localhost:3000

# ── Session / Cookies ────────────────────────────────
# Enforced behind HTTPS
SESSION_COOKIE_SECURE=true

# ── Domain / SSL ─────────────────────────────────────
DOMAIN=timewin.yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# ── Rate Limiting (defaults shown, override if needed) ──
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000
# HEAVY_RATE_LIMIT_MAX=20
# HEAVY_RATE_LIMIT_WINDOW_MS=60000

# ── Monitoring ───────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── AI Engine (optional) ────────────────────────────
GEMINI_API_KEY=
AI_ENGINE_ENABLED=true

# ── Email (Resend SMTP) ─────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── Web Push (VAPID) ────────────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
